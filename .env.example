# Base de datos del negocio
POSTGRES_DB=taller_ecu
POSTGRES_USER=taller_app
POSTGRES_PASSWORD=CHANGE_ME

# Base de datos interna de n8n
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=CHANGE_ME

# Clave con la que n8n cifra sus credenciales.
# Si se pierde, las credenciales guardadas dejan de ser recuperables.
N8N_ENCRYPTION_KEY=CHANGE_ME

# Token de verificación del webhook de Meta
WHATSAPP_VERIFY_TOKEN=CHANGE_ME

# Clave compartida entre n8n y el backend.
# No debe llegar nunca al navegador ni usarse para el panel.
INTERNAL_API_KEY=CHANGE_ME
