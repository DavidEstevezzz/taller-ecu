---
import { px, py, topFace, sideFaces, trace, grid } from "../lib/iso";

/**
 * La capa de software, abierta.
 *
 * Es la profundización del primer diagrama de `/servicios`: allí el mapa
 * entraba en una unidad cerrada; aquí se mira el mapa por dentro.
 *
 * Dos planos sobre la unidad:
 *   - el de abajo, en gris, es la gestión original;
 *   - el de arriba, en cobre, es la misma retícula con algunas celdas
 *     ajustadas.
 *
 * Dice exactamente lo que dice el texto de la página —«se trabaja sobre la
 * gestión original, no sobre un parche montado encima»— y no dice nada más:
 *
 * - **Ningún valor.** Un mapa de calibración es una tabla; se dibuja como la
 *   tabla que es, con las casillas vacías. Escribir cifras sería inventar
 *   datos técnicos.
 * - **Ninguna curva.** Nada de gráficas de potencia: no tenemos ni una sola
 *   medición propia, y el proveedor no nos autoriza a reproducir las suyas.
 * - **Ninguna escala, ningún eje, ninguna unidad.**
 */
interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id = "map-layer" } = Astro.props;

/* Medidas. Misma proyección y mismo chaflán que el resto del sitio. */
const OX = 250;
const W = 300;
const D = 186;
const C = 34;

const Y_REVISED = 40; // el mapa ajustado, arriba
const Y_ORIGINAL = 150; // la gestión original, debajo
const Y_UNIT = 292; // la unidad, cerrada

const COLS = 8;
const ROWS = 6;

/* Celdas ajustadas. Son una selección arbitraria y contigua para que se lea
   «se tocan zonas concretas», no un dato: no representan ningún régimen ni
   ninguna carga. */
const TOUCHED: Array<[number, number]> = [
  [3, 2],
  [4, 2],
  [5, 2],
  [4, 3],
  [5, 3],
  [6, 3],
  [5, 4],
  [6, 4],
];

const cellW = W / COLS;
const cellD = D / ROWS;

const touchedCells = TOUCHED.map(([c, r]) => {
  const u = cellW * c;
  const v = cellD * r;
  return topFace(px(OX, u, v), py(Y_REVISED, u, v), cellW, cellD, 0);
});

/* Hilos verticales que atan las tres capas: el mapa va a la unidad. */
const TIES = [
  [0, 0],
  [W, 0],
  [W, D],
  [0, D],
] as const;
---

<div class={`map-stage ${className}`} data-map-stage>
  <svg
    viewBox="38 18 664 578"
    class="map-svg"
    role="img"
    aria-labelledby={`${id}-t ${id}-d`}
    fill="none"
  >
    <title id={`${id}-t`}>La capa de software de una centralita</title>
    <desc id={`${id}-d`}>
      Dibujo esquemático de tres capas: abajo la centralita cerrada, encima la
      retícula del mapa original y sobre ella la misma retícula con algunas
      casillas ajustadas. Es un esquema sin valores, escalas ni mediciones.
    </desc>

    <!-- Hilos de correspondencia entre las tres capas -->
    <g class="map-part" style="--step: 0">
      {
        TIES.map(([u, v]) => (
          <path
            d={`M ${px(OX, u!, v!)} ${py(Y_REVISED, u!, v!)} L ${px(OX, u!, v!)} ${py(Y_UNIT, u!, v!)}`}
            class="tie"
          />
        ))
      }
    </g>

    <!-- La unidad, cerrada: en una reprogramación no se abre -->
    <g class="map-part" style="--step: 1">
      {
        sideFaces(OX, Y_UNIT, W, D, C, 30).map((d) => (
          <path d={d} class="face-side" />
        ))
      }
      <path d={topFace(OX, Y_UNIT, W, D, C)} class="face-top" />
      <path d={trace(OX, Y_UNIT, 56, 52, [[1, 190]])} class="etch" />
      <path d={trace(OX, Y_UNIT, 56, 86, [[1, 190]])} class="etch" />
    </g>

    <!-- La gestión original -->
    <g class="map-part" style="--step: 2">
      <path d={topFace(OX, Y_ORIGINAL, W, D, 0)} class="plane-base" />
      {grid(OX, Y_ORIGINAL, W, D, COLS, ROWS).map((d) => (
        <path d={d} class="line-base" />
      ))}
      <path d={topFace(OX, Y_ORIGINAL, W, D, 0)} class="edge-base" />
    </g>

    <!-- La misma retícula, con algunas casillas ajustadas -->
    <g class="map-part" style="--step: 3">
      <path d={topFace(OX, Y_REVISED, W, D, 0)} class="plane-revised" />
      {touchedCells.map((d, i) => (
        <path d={d} class="cell-touched" style={`--cell: ${i}`} />
      ))}
      {grid(OX, Y_REVISED, W, D, COLS, ROWS).map((d) => (
        <path d={d} class="line-revised" />
      ))}
      <path d={topFace(OX, Y_REVISED, W, D, 0)} class="edge-revised" />
    </g>

    <!-- Rótulos -->
    <g class="map-labels">
      <g class="map-label" style="--step: 0">
        <path
          d={`M ${px(OX, W, 0)} ${py(Y_REVISED, W, 0)} L 566 ${py(Y_REVISED, W, 0)}`}
          class="leader"></path>
        <circle cx="572" cy={py(Y_REVISED, W, 0)} r="4" class="leader-pad"
        ></circle>
        <text x="584" y={py(Y_REVISED, W, 0) + 5} class="label-name">
          Ajustado
        </text>
      </g>

      <g class="map-label" style="--step: 1">
        <path
          d={`M ${px(OX, W, 0)} ${py(Y_ORIGINAL, W, 0)} L 566 ${py(Y_ORIGINAL, W, 0)}`}
          class="leader"></path>
        <circle cx="572" cy={py(Y_ORIGINAL, W, 0)} r="4" class="leader-pad"
        ></circle>
        <text x="584" y={py(Y_ORIGINAL, W, 0) + 5} class="label-name">
          Original
        </text>
      </g>

      <g class="map-label" style="--step: 2">
        <path
          d={`M ${px(OX, W, C)} ${py(Y_UNIT, W, C)} L 566 ${py(Y_UNIT, W, C)}`}
          class="leader"></path>
        <circle cx="572" cy={py(Y_UNIT, W, C)} r="4" class="leader-pad"></circle>
        <text x="584" y={py(Y_UNIT, W, C) + 5} class="label-name">Unidad</text>
      </g>
    </g>
  </svg>
</div>

<style>
  .map-stage {
    position: relative;
    width: 100%;
  }

  .map-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .face-top {
    fill: var(--jm-graphite-700);
    stroke: var(--jm-graphite-500);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .face-side {
    fill: var(--jm-graphite-800);
    stroke: var(--jm-graphite-600);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .etch {
    stroke: var(--jm-graphite-600);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .tie {
    stroke: var(--jm-graphite-700);
    stroke-width: 1;
    stroke-dasharray: 3 5;
  }

  /* La gestión original: presente, pero en segundo plano. */
  .plane-base {
    fill: color-mix(in srgb, var(--jm-graphite-400) 7%, transparent);
  }

  .line-base {
    stroke: color-mix(in srgb, var(--jm-graphite-400) 32%, transparent);
    stroke-width: 1;
  }

  .edge-base {
    fill: none;
    stroke: var(--jm-graphite-400);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* La revisión: cobre, como todo lo que es intervención. */
  .plane-revised {
    fill: color-mix(in srgb, var(--jm-copper-500) 8%, transparent);
  }

  .line-revised {
    stroke: color-mix(in srgb, var(--jm-copper-300) 40%, transparent);
    stroke-width: 1;
  }

  .edge-revised {
    fill: none;
    stroke: var(--jm-copper-400);
    stroke-width: 1.75;
    stroke-linejoin: round;
  }

  .cell-touched {
    fill: color-mix(in srgb, var(--jm-copper-500) 58%, transparent);
  }

  .leader {
    stroke: var(--jm-graphite-600);
    stroke-width: 1.25;
    stroke-dasharray: 4 4;
  }

  .leader-pad {
    fill: var(--jm-copper-400);
  }

  .label-name {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--color-ink-inverse);
  }

  /*
   * Las capas se apilan al entrar en pantalla, de abajo arriba: la unidad,
   * el mapa original y encima el ajustado. Es el orden en que ocurre.
   * Solo bajo `.js-anim`: sin JavaScript, o con movimiento reducido, el
   * dibujo se sirve montado.
   */
  :global(.js-anim) .map-part,
  :global(.js-anim) .map-label {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity var(--duration-reveal) var(--ease-settle),
      transform var(--duration-reveal) var(--ease-settle);
    transition-delay: calc(var(--step) * 130ms);
  }

  :global(.js-anim) .map-label {
    transform: translateX(-12px);
    transition-delay: calc(560ms + var(--step) * 110ms);
  }

  :global(.js-anim) .map-svg.is-visible .map-part,
  :global(.js-anim) .map-svg.is-visible .map-label {
    opacity: 1;
    transform: none;
  }

  /* Las casillas ajustadas se encienden una a una, al final. */
  :global(.js-anim) .cell-touched {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    transition-delay: calc(700ms + var(--cell) * 70ms);
  }

  :global(.js-anim) .map-svg.is-visible .cell-touched {
    opacity: 1;
  }
</style>
