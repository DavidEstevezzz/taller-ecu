---
/**
 * Pieza protagonista del concepto: objetivo, explicación y curva forman un
 * solo instrumento. Es una representación conceptual, nunca una medición.
 *
 * Los radios y las cinco curvas viajan en el HTML. Sin JavaScript cambia el
 * estado con CSS; el script solo interpola la forma y actualiza la plantilla
 * de WhatsApp.
 */
import CdxWhatsApp from "./CdxWhatsApp.astro";
import {
  CONTACT,
  REPRO_BAND_CAVEAT,
  REPRO_BASELINE_BAND,
  REPRO_GOALS,
  REPRO_MESSAGE,
  REPRO_MESSAGE_LINES,
} from "../../config/site";

const VIEW_W = 1000;
const VIEW_H = 320;
const X0 = 42;
const X1 = 958;
const TOP = 34;
const BASE = 278;
const SPAN = X1 - X0;
const HEIGHT = BASE - TOP;
const SAMPLES = 25;

interface Shape {
  rise: number;
  slope: number;
  hold: number;
  drop: number;
  top: number;
}

function sample({ rise, slope, hold, drop, top }: Shape): number[] {
  return Array.from({ length: SAMPLES }, (_, i) => {
    const t = i / (SAMPLES - 1);
    const up = 1 / (1 + Math.exp(-(t - rise) / slope));
    const down = t <= hold ? 1 : Math.exp(-(((t - hold) / drop) ** 2));
    return top * up * down;
  });
}

const px = (i: number): number => X0 + (SPAN * i) / (SAMPLES - 1);
const py = (value: number): number => BASE - value * HEIGHT;

function curve(values: number[]): string {
  const points = values.map((value, i) => [px(i), py(value)] as const);
  let d = `M ${points[0]![0].toFixed(1)} ${points[0]![1].toFixed(1)}`;

  for (let i = 0; i < points.length - 1; i += 1) {
    const p0 = points[Math.max(i - 1, 0)]!;
    const p1 = points[i]!;
    const p2 = points[i + 1]!;
    const p3 = points[Math.min(i + 2, points.length - 1)]!;
    d += ` C ${(p1[0] + (p2[0] - p0[0]) / 6).toFixed(1)} ${(p1[1] + (p2[1] - p0[1]) / 6).toFixed(1)}, ${(p2[0] - (p3[0] - p1[0]) / 6).toFixed(1)} ${(p2[1] - (p3[1] - p1[1]) / 6).toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
  }

  return d;
}

const area = (values: number[]): string =>
  `${curve(values)} L ${X1} ${BASE} L ${X0} ${BASE} Z`;

const baseline = sample(REPRO_BASELINE_BAND);
const baselinePath = curve(baseline);
const goals = REPRO_GOALS.map((goal) => {
  const values = sample(goal.band);
  const zoneX = X0 + goal.zone[0] * SPAN;
  const zoneW = (goal.zone[1] - goal.zone[0]) * SPAN;

  return {
    ...goal,
    values,
    path: curve(values),
    area: area(values),
    zoneX,
    zoneW,
    message: [
      ...REPRO_MESSAGE_LINES.slice(0, -1),
      `${REPRO_MESSAGE_LINES.at(-1)} ${goal.goal}`,
    ].join("\n"),
  };
});

const data = JSON.stringify({
  x0: X0,
  x1: X1,
  base: BASE,
  height: HEIGHT,
  samples: SAMPLES,
  stock: baseline.map((value) => Number(value.toFixed(4))),
  goals: goals.map((goal) => ({
    id: goal.id,
    values: goal.values.map((value) => Number(value.toFixed(4))),
    zone: [Number(goal.zoneX.toFixed(1)), Number(goal.zoneW.toFixed(1))],
    message: goal.message,
  })),
});

const verticals = Array.from({ length: 9 }, (_, i) => X0 + (SPAN * i) / 8);
const horizontals = [82, 132, 182, 232];
---

<div
  class="cdx-response"
  data-cdx-response
  data-response={data}
  data-number={CONTACT.whatsappNumber}
>
  <fieldset class="cdx-response__set">
    <legend class="cdx-sr">Qué quieres notar al conducir</legend>

    {
      REPRO_GOALS.map((goal, index) => (
        <input
          class="cdx-response__radio"
          type="radio"
          id={`cdx-response-${goal.id}`}
          name="cdx-response-goal"
          value={goal.id}
          checked={index === 0}
        />
      ))
    }

    <div class="cdx-response__modes" aria-label="Objetivos">
      {
        REPRO_GOALS.map((goal) => (
          <label class="cdx-response__mode" for={`cdx-response-${goal.id}`}>
            <span class="cdx-response__modeName">{goal.tab}</span>
            <span class="cdx-response__modeHint">{goal.title}</span>
          </label>
        ))
      }
    </div>

    <div class="cdx-response__body">
      <div class="cdx-response__copy" aria-live="polite">
        <p class="cdx-kicker">Respuesta seleccionada</p>
        {
          goals.map((goal) => (
            <div class={`cdx-response__only cdx-response__only--${goal.id}`}>
              <h3>{goal.title}</h3>
              <p>{goal.body}</p>
            </div>
          ))
        }

        <div class="cdx-response__legend">
          <p><span class="cdx-response__key cdx-response__key--stock"></span>Entrega de partida</p>
          <p><span class="cdx-response__key cdx-response__key--goal"></span>Según el objetivo</p>
        </div>

        <CdxWhatsApp
          class="cdx-response__cta"
          variant="quiet"
          label="Consultar este objetivo"
          message={REPRO_MESSAGE}
          data-cdx-response-link
        />
      </div>

      <div class="cdx-response__plot">
        <div class="cdx-response__depth" aria-hidden="true"></div>
        <svg
          class="cdx-response__svg"
          viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
          preserveAspectRatio="none"
          role="img"
          aria-labelledby="cdx-curve-title cdx-curve-desc"
          fill="none"
        >
          <title id="cdx-curve-title">Cómo cambia la forma de la entrega</title>
          <desc id="cdx-curve-desc">
            Comparación conceptual entre la entrega de partida y la que se
            busca según el objetivo seleccionado. No contiene cifras, escala
            ni datos de un vehículo real.
          </desc>

          <defs>
            <linearGradient id="cdx-curve-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--cdx-copper-bright)" stop-opacity=".34" />
              <stop offset="1" stop-color="var(--cdx-copper)" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="cdx-zone-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--cdx-copper-bright)" stop-opacity="0" />
              <stop offset="1" stop-color="var(--cdx-copper)" stop-opacity=".24" />
            </linearGradient>
          </defs>

          <g class="cdx-response__grid" aria-hidden="true">
            {verticals.map((x) => <line x1={x} x2={x} y1={TOP} y2={BASE} />)}
            {horizontals.map((y) => <line x1={X0} x2={X1} y1={y} y2={y} />)}
          </g>
          <line class="cdx-response__axis" x1={X0} x2={X1} y1={BASE} y2={BASE} />

          <g class="cdx-response__zonesStatic">
            {
              goals.map((goal) => (
                <rect
                  class={`cdx-response__zone cdx-response__zone--${goal.id}`}
                  x={goal.zoneX}
                  y={TOP}
                  width={goal.zoneW}
                  height={BASE - TOP}
                  fill="url(#cdx-zone-fill)"
                />
              ))
            }
          </g>

          <rect
            class="cdx-response__zoneLive"
            data-cdx-zone
            x={goals[0]!.zoneX}
            y={TOP}
            width={goals[0]!.zoneW}
            height={BASE - TOP}
            fill="url(#cdx-zone-fill)"
          />

          <path class="cdx-response__stock" d={baselinePath} />

          <g class="cdx-response__static">
            {
              goals.map((goal) => (
                <g class={`cdx-response__only cdx-response__only--${goal.id}`}>
                  <path class="cdx-response__area" d={goal.area} fill="url(#cdx-curve-fill)" />
                  <path class="cdx-response__glow" d={goal.path} />
                  <path class="cdx-response__line" d={goal.path} />
                </g>
              ))
            }
          </g>

          <g class="cdx-response__live">
            <path data-cdx-area class="cdx-response__area" d={goals[0]!.area} fill="url(#cdx-curve-fill)" />
            <path data-cdx-glow class="cdx-response__glow" d={goals[0]!.path} />
            <path data-cdx-line class="cdx-response__line" d={goals[0]!.path} />
          </g>
        </svg>

        <p class="cdx-response__axisLabels">
          <span>ralentí</span>
          <span>régimen del motor</span>
          <span>corte</span>
        </p>
        <p class="cdx-response__caveat">{REPRO_BAND_CAVEAT}</p>
      </div>
    </div>
  </fieldset>
</div>

<script>
  import "../../scripts/concept-codex-response";
</script>

<style>
  .cdx-response__set { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .cdx-response__radio { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .cdx-response__modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block: 1px solid var(--cdx-line); }
  .cdx-response__mode { position: relative; display: flex; min-block-size: 4.75rem; flex-direction: column; justify-content: center; gap: .2rem; border-inline-end: 1px solid var(--cdx-line); border-block-end: 1px solid var(--cdx-line); padding: .8rem .9rem; cursor: pointer; touch-action: manipulation; color: var(--cdx-muted); transition: color var(--cdx-fast) var(--cdx-ease), background-color var(--cdx-fast) var(--cdx-ease); }
  .cdx-response__mode::before { content: ""; position: absolute; inset: 0; border-block-start: 3px solid transparent; pointer-events: none; transition: border-color var(--cdx-fast) var(--cdx-ease), box-shadow var(--cdx-fast) var(--cdx-ease); }
  .cdx-response__modeName { font-family: var(--cdx-display); font-size: 1.15rem; font-weight: 800; line-height: 1; text-transform: uppercase; }
  .cdx-response__modeHint { font-size: .75rem; line-height: 1.3; }
  .cdx-response__mode:hover { color: var(--cdx-paper); background: var(--cdx-surface-raised); }

  .cdx-response__body { display: grid; min-inline-size: 0; border-block-end: 1px solid var(--cdx-line); }
  .cdx-response__copy { display: flex; min-block-size: 19rem; flex-direction: column; align-items: flex-start; padding: clamp(1.4rem, 3vw, 2.5rem); border-block-end: 1px solid var(--cdx-line); background: linear-gradient(145deg, var(--cdx-surface-raised), var(--cdx-surface)); }
  .cdx-response__copy h3 { margin-block-start: .8rem; max-inline-size: 13ch; font-family: var(--cdx-display); font-size: clamp(1.8rem, 3.2vw, 2.9rem); font-weight: 800; line-height: 1; letter-spacing: -.03em; overflow-wrap: break-word; text-wrap: balance; }
  .cdx-response__copy h3 + p { margin-block-start: 1rem; max-inline-size: 31rem; color: var(--cdx-muted); font-size: 1.02rem; line-height: 1.55; text-wrap: pretty; }
  .cdx-response__only { display: none; }
  .cdx-response__legend { display: flex; flex-wrap: wrap; gap: .6rem 1rem; margin-block-start: auto; padding-block-start: 1.5rem; color: var(--cdx-muted); font-family: var(--cdx-mono); font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; }
  .cdx-response__legend p { display: flex; align-items: center; gap: .5rem; }
  .cdx-response__key { display: block; inline-size: 1.7rem; block-size: 2px; background: currentColor; }
  .cdx-response__key--goal { block-size: 3px; background: var(--cdx-copper-bright); box-shadow: 0 0 10px color-mix(in srgb, var(--cdx-copper) 55%, transparent); }
  .cdx-response__cta { margin-block-start: 1.1rem; }

  .cdx-response__plot { position: relative; min-inline-size: 0; overflow: hidden; padding: clamp(1rem, 2vw, 1.75rem); background: radial-gradient(circle at 58% 78%, color-mix(in srgb, var(--cdx-copper) 10%, transparent), transparent 35%), var(--cdx-void); }
  .cdx-response__depth { position: absolute; inset: 1rem; border: 1px solid color-mix(in srgb, var(--cdx-line) 70%, transparent); box-shadow: inset 0 0 45px rgb(0 0 0 / .58), 0 22px 55px rgb(0 0 0 / .28); pointer-events: none; }
  .cdx-response__svg { position: relative; display: block; inline-size: 100%; block-size: 15rem; }
  .cdx-response__svg :is(path, line) { vector-effect: non-scaling-stroke; }
  .cdx-response__grid line { stroke: var(--cdx-grid); stroke-width: 1; }
  .cdx-response__axis { stroke: var(--cdx-line-strong); stroke-width: 1.5; }
  .cdx-response__stock { stroke: var(--cdx-steel); stroke-width: 2.25; stroke-dasharray: 5 7; stroke-linecap: round; }
  .cdx-response__line { stroke: var(--cdx-copper-bright); stroke-width: 4.5; stroke-linecap: round; }
  .cdx-response__glow { stroke: var(--cdx-copper); stroke-width: 15; stroke-linecap: round; opacity: .22; }
  .cdx-response__zone { display: none; }
  .cdx-response__zoneLive, .cdx-response__live { display: none; }
  .cdx-response.is-live .cdx-response__static, .cdx-response.is-live .cdx-response__zonesStatic { display: none; }
  .cdx-response.is-live .cdx-response__zoneLive, .cdx-response.is-live .cdx-response__live { display: block; }
  .cdx-response__axisLabels { position: relative; display: flex; justify-content: space-between; gap: 1rem; margin-block-start: .5rem; color: var(--cdx-dim); font-family: var(--cdx-mono); font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .cdx-response__caveat { position: relative; max-inline-size: 48rem; margin-block-start: 1rem; border-inline-start: 2px solid var(--cdx-line-strong); padding-inline-start: .85rem; color: var(--cdx-dim); font-size: .78rem; line-height: 1.5; }

  .cdx-response__radio:nth-of-type(1):checked ~ .cdx-response__modes > :nth-child(1),
  .cdx-response__radio:nth-of-type(2):checked ~ .cdx-response__modes > :nth-child(2),
  .cdx-response__radio:nth-of-type(3):checked ~ .cdx-response__modes > :nth-child(3),
  .cdx-response__radio:nth-of-type(4):checked ~ .cdx-response__modes > :nth-child(4),
  .cdx-response__radio:nth-of-type(5):checked ~ .cdx-response__modes > :nth-child(5) { color: var(--cdx-paper); background: var(--cdx-surface-raised); }
  .cdx-response__radio:nth-of-type(1):checked ~ .cdx-response__modes > :nth-child(1)::before,
  .cdx-response__radio:nth-of-type(2):checked ~ .cdx-response__modes > :nth-child(2)::before,
  .cdx-response__radio:nth-of-type(3):checked ~ .cdx-response__modes > :nth-child(3)::before,
  .cdx-response__radio:nth-of-type(4):checked ~ .cdx-response__modes > :nth-child(4)::before,
  .cdx-response__radio:nth-of-type(5):checked ~ .cdx-response__modes > :nth-child(5)::before { border-color: var(--cdx-copper-bright); box-shadow: inset 0 5px 12px color-mix(in srgb, var(--cdx-copper) 10%, transparent); }
  .cdx-response__radio:nth-of-type(1):focus-visible ~ .cdx-response__modes > :nth-child(1),
  .cdx-response__radio:nth-of-type(2):focus-visible ~ .cdx-response__modes > :nth-child(2),
  .cdx-response__radio:nth-of-type(3):focus-visible ~ .cdx-response__modes > :nth-child(3),
  .cdx-response__radio:nth-of-type(4):focus-visible ~ .cdx-response__modes > :nth-child(4),
  .cdx-response__radio:nth-of-type(5):focus-visible ~ .cdx-response__modes > :nth-child(5) { outline: 3px solid var(--cdx-focus); outline-offset: -4px; }

  .cdx-response__radio:nth-of-type(1):checked ~ .cdx-response__body .cdx-response__only--respuesta,
  .cdx-response__radio:nth-of-type(2):checked ~ .cdx-response__body .cdx-response__only--empuje,
  .cdx-response__radio:nth-of-type(3):checked ~ .cdx-response__body .cdx-response__only--elasticidad,
  .cdx-response__radio:nth-of-type(4):checked ~ .cdx-response__body .cdx-response__only--diario,
  .cdx-response__radio:nth-of-type(5):checked ~ .cdx-response__body .cdx-response__only--preparado { display: block; }
  .cdx-response__radio:nth-of-type(1):checked ~ .cdx-response__body .cdx-response__zone--respuesta,
  .cdx-response__radio:nth-of-type(2):checked ~ .cdx-response__body .cdx-response__zone--empuje,
  .cdx-response__radio:nth-of-type(3):checked ~ .cdx-response__body .cdx-response__zone--elasticidad,
  .cdx-response__radio:nth-of-type(4):checked ~ .cdx-response__body .cdx-response__zone--diario,
  .cdx-response__radio:nth-of-type(5):checked ~ .cdx-response__body .cdx-response__zone--preparado { display: block; }

  @media (min-width: 42rem) {
    .cdx-response__modes { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .cdx-response__mode { border-block-end: 0; }
  }
  @media (min-width: 64rem) {
    .cdx-response__body { grid-template-columns: minmax(17rem, 4fr) minmax(0, 8fr); }
    .cdx-response__copy { border-block-end: 0; border-inline-end: 1px solid var(--cdx-line); }
    .cdx-response__svg { block-size: 19rem; }
  }
  @media (max-width: 25rem) {
    .cdx-response__modes { grid-template-columns: 1fr; }
  }
</style>
