---
/**
 * Variante experimental basada en el Concepto A.
 *
 * Conserva su fotografía nocturna, su paleta y su orientación a lo que nota
 * el conductor. Cambia la composición: una trayectoria de cobre conecta el
 * hero, la banda de entrega y el selector de configuraciones.
 */
import { Image } from "astro:assets";

import ConceptoCodexLayout from "../../layouts/ConceptoCodexLayout.astro";
import CdxConfigurator from "../../components/concepto-codex/CdxConfigurator.astro";
import CdxDeliveryStudio from "../../components/concepto-codex/CdxDeliveryStudio.astro";
import CdxStageSelector from "../../components/concepto-codex/CdxStageSelector.astro";
import CdxWhatsApp from "../../components/concepto-codex/CdxWhatsApp.astro";
import {
  CONTACT,
  REPRO_MESSAGE,
  REPRO_SEND,
} from "../../config/site";

import heroImage from "../../assets/photos/coche-tunel-noche.jpg";
---

<ConceptoCodexLayout
  title="Concepto Codex · Reprogramación — JM Repro Cars"
  description="Maqueta interna de una nueva dirección visual para la página de reprogramación. No es una página pública."
>
  <!-- Acceso persistente en escritorio; en móvil la misma acción vive en el hero. -->
  <a class="cdx-calc" href="#datos">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 19V5M4 19h16M7 16c3 0 4-4 7-7 1.5-1.5 3-2.2 5-2.2" />
      <path d="m16 5.8 3-.1-.1 3" />
    </svg>
    <span>Calcular mejora</span>
  </a>

  <section class="cdx-hero" aria-labelledby="cdx-hero-title">
    <Image
      src={heroImage}
      alt="Un coche circulando de noche por un túnel, captado con barrido: la carrocería nítida y el entorno movido"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
      class="cdx-hero__image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="cdx-hero__wash" aria-hidden="true"></div>
    <p class="cdx-hero__side" aria-hidden="true">Reprogramación</p>

    <div class="cdx-hero__content">
      <p class="cdx-kicker cdx-hero__kicker">
        Reprogramación de centralita · {CONTACT.area}
      </p>
      <h1 id="cdx-hero-title">
        Que responda<br />
        <em>cuando lo pides.</em>
      </h1>
      <p class="cdx-hero__lead">
        Ajustamos la gestión del motor a tu vehículo y a cómo lo conduces:
        respuesta al acelerador, recuperaciones, elasticidad y entrega.
      </p>
      <div class="cdx-hero__actions">
        <CdxWhatsApp label="Consultar mi vehículo" message={REPRO_MESSAGE} />
        <a class="cdx-btn cdx-btn--quiet" href="#sensaciones">
          Elegir qué quiero notar
          <span aria-hidden="true">↓</span>
        </a>
        <a class="cdx-btn cdx-btn--quiet cdx-hero__calc" href="#datos">
          Calcular mejora
        </a>
      </div>
    </div>

    <dl class="cdx-hero__rail">
      <div>
        <dt>Al pisar</dt>
        <dd>Respuesta más directa</dd>
      </div>
      <div>
        <dt>En marcha</dt>
        <dd>Más empuje y recuperación</dd>
      </div>
      <div>
        <dt>En tu uso</dt>
        <dd>Entrega adaptada al vehículo</dd>
      </div>
    </dl>

    <!-- La trayectoria se convierte en curva en la sección siguiente. -->
    <svg class="cdx-hero__trail" viewBox="0 0 1600 190" preserveAspectRatio="none" aria-hidden="true">
      <path class="cdx-hero__trailGlow" d="M0 154 C320 154 420 84 662 94 S1080 178 1600 42" />
      <path class="cdx-hero__trailLine" pathLength="1" d="M0 154 C320 154 420 84 662 94 S1080 178 1600 42" />
    </svg>
  </section>

  <section id="sensaciones" class="cdx-section cdx-sense" aria-labelledby="cdx-sense-title">
    <div class="cdx-wrap">
      <div class="cdx-sectionHead">
        <div>
          <p class="cdx-kicker">Qué quieres notar</p>
          <h2 id="cdx-sense-title">La entrega, puesta donde conduces.</h2>
        </div>
        <p class="cdx-sectionHead__lead">
          Elige un objetivo. La explicación y la curva responden juntas para
          mostrar en qué zona se busca el cambio, sin inventar una sola cifra.
        </p>
      </div>
      <CdxDeliveryStudio />
    </div>
  </section>

  <div class="cdx-pivot" aria-hidden="true">
    <span>El objetivo marca la dirección</span>
    <i></i>
    <span>El vehículo decide el ajuste</span>
  </div>

  <section
    id="configuraciones"
    class="cdx-section cdx-stages"
    aria-labelledby="cdx-stages-title"
  >
    <div class="cdx-wrap">
      <div class="cdx-sectionHead cdx-sectionHead--stages">
        <div>
          <p class="cdx-kicker">Configuraciones</p>
          <h2 id="cdx-stages-title">Cinco puntos de partida. Uno para tu caso.</h2>
        </div>
        <p class="cdx-sectionHead__lead">
          Selecciona una opción para entender rápido cuándo encaja. La decisión
          final siempre depende del vehículo, su estado y lo que lleve montado.
        </p>
      </div>
      <CdxStageSelector />
    </div>
  </section>

  <section id="datos" class="cdx-section cdx-data" aria-labelledby="cdx-data-title">
    <div class="cdx-wrap cdx-data__grid">
      <div class="cdx-data__intro">
        <p class="cdx-kicker">Antes de escribir</p>
        <h2 id="cdx-data-title">Una referencia para tu motorización.</h2>
        <p>
          Consulta los datos orientativos de Tuning-shop.com cuando quieras.
          La herramienta solo se carga al solicitarla; hasta entonces no
          contacta con el proveedor.
        </p>
      </div>
      <div class="cdx-data__tool">
        <CdxConfigurator headingId="cdx-configurator-title" />
      </div>
    </div>
  </section>

  <section class="cdx-close" aria-labelledby="cdx-close-title">
    <div class="cdx-wrap cdx-close__grid">
      <div>
        <p class="cdx-kicker cdx-close__kicker">Tu caso, no una cifra genérica</p>
        <h2 id="cdx-close-title">Cuéntanos el vehículo.</h2>
        <p class="cdx-close__lead">
          Con lo que tengas ya podemos empezar. Revisamos el caso y te decimos
          qué opción tiene sentido antes de confirmar ningún resultado.
        </p>
      </div>
      <div class="cdx-close__action">
        <ul>
          {REPRO_SEND.map((item) => <li>{item}</li>)}
        </ul>
        <CdxWhatsApp
          variant="onCopper"
          label="Abrir WhatsApp"
          message={REPRO_MESSAGE}
        />
        <p>{CONTACT.whatsappDisplay}</p>
      </div>
    </div>
  </section>

  <!--
    Retira el atajo flotante en cuanto se llega a la sección de datos, para que
    no se superponga al texto de la herramienta ni al cierre. Es puro adorno:
    si no hay JavaScript, la pastilla se queda quieta y sigue funcionando.
  -->
  <script is:inline>
    (function () {
      var pill = document.querySelector(".cdx-calc");
      var target = document.getElementById("datos");
      if (!pill || !target || !("IntersectionObserver" in window)) return;
      new IntersectionObserver(
        function (entries) {
          var entry = entries[0];
          pill.classList.toggle(
            "is-away",
            entry.isIntersecting || entry.boundingClientRect.top < 0
          );
        },
        { rootMargin: "0px 0px -35% 0px" }
      ).observe(target);
    })();
  </script>
</ConceptoCodexLayout>
